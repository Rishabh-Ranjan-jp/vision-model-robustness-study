import torchvision.models as models
import torch.nn as nn
import torch
from sklearn.model_selection import StratifiedKFold
from torch.utils.data import Subset
import time

# ==========================================
# Architectures
# ==========================================
class BaselineCNN(nn.Module):
    def __init__(self, num_classes=10, in_channels=3):
        super().__init__()
        self.features = nn.Sequential(
            # 🔥 DYNAMIC CHANNELS: Accepts 1 (Grayscale) or 3 (RGB)
            nn.Conv2d(in_channels, 32, kernel_size=3, padding=1),
            nn.BatchNorm2d(32),
            nn.ReLU(inplace=True),
            nn.MaxPool2d(2, 2),

            nn.Conv2d(32, 64, kernel_size=3, padding=1),
            nn.BatchNorm2d(64),
            nn.ReLU(inplace=True),
            nn.MaxPool2d(2, 2),

            nn.Conv2d(64, 128, kernel_size=3, padding=1),
            nn.BatchNorm2d(128),
            nn.ReLU(inplace=True),
            nn.MaxPool2d(2, 2),

            nn.Conv2d(128, 256, kernel_size=3, padding=1),
            nn.BatchNorm2d(256),
            nn.ReLU(inplace=True),
            nn.MaxPool2d(2, 2)
        )
        self.gap = nn.AdaptiveAvgPool2d((1, 1))
        self.classifier = nn.Sequential(
            nn.Flatten(),
            nn.Dropout(0.2),
            nn.Linear(256, num_classes)
        )

    def forward(self, x):
        return self.classifier(self.gap(self.features(x)))

def build_model(name, num_classes=10, in_channels=3):
    if name == "Baseline_CNN":
        return BaselineCNN(num_classes=num_classes, in_channels=in_channels)
        
    elif name == "ResNet18":
        m = models.resnet18(weights=None)
        # 🔥 SURGICAL FIX: Replace first Conv layer if dataset is grayscale
        if in_channels != 3:
            m.conv1 = nn.Conv2d(in_channels, 64, kernel_size=7, stride=2, padding=3, bias=False)
        m.fc = nn.Linear(m.fc.in_features, num_classes)
        return m
        
    elif name == "MobileNetV2":
        m = models.mobilenet_v2(weights=None)
        # 🔥 SURGICAL FIX: Replace first Conv layer if dataset is grayscale
        if in_channels != 3:
            m.features[0][0] = nn.Conv2d(in_channels, 32, kernel_size=3, stride=2, padding=1, bias=False)
        m.classifier[1] = nn.Linear(m.classifier[1].in_features, num_classes)
        return m

def count_parameters(model):
    return sum(p.numel() for p in model.parameters() if p.requires_grad)

# ==========================================
# Step Logic
# ==========================================
def train_one_epoch(model, loader, criterion, optimizer, device):
    model.train()
    running_loss, correct, total = 0.0, 0, 0
    for images, labels in loader:
        images, labels = images.to(device), labels.to(device)
        optimizer.zero_grad()
        outputs = model(images)
        loss = criterion(outputs, labels)
        loss.backward()
        optimizer.step()
        
        running_loss += loss.item() * images.size(0)
        _, preds = outputs.max(1)
        correct += preds.eq(labels).sum().item()
        total += labels.size(0)
    return running_loss / total, 100.0 * correct / total

@torch.no_grad()
def evaluate_epoch(model, loader, criterion, device):
    model.eval()
    running_loss, correct, total = 0.0, 0, 0
    for images, labels in loader:
        images, labels = images.to(device), labels.to(device)
        outputs = model(images)
        loss = criterion(outputs, labels)
        
        running_loss += loss.item() * images.size(0)
        _, preds = outputs.max(1)
        correct += preds.eq(labels).sum().item()
        total += labels.size(0)
    return running_loss / total, 100.0 * correct / total
import os
import glob
import copy
import time
import json
import optuna
import torch
import numpy as np
from sklearn.model_selection import train_test_split
from torch.utils.data import Subset, DataLoader
from tqdm.auto import tqdm

class EarlyStopping:
    def __init__(self, patience=5, min_delta=1e-4):
        self.patience = patience
        self.min_delta = min_delta
        self.counter = 0
        self.best_loss = float('inf')
        self.best_val_acc = 0.0
        self.best_train_acc = 0.0
        self.best_model_weights = None
        self.early_stop = False

    def step(self, val_loss, val_acc, train_acc, model):
        if val_loss < self.best_loss - self.min_delta:
            self.best_loss = val_loss
            self.best_val_acc = val_acc
            self.best_train_acc = train_acc
            self.best_model_weights = copy.deepcopy(model.state_dict())
            self.counter = 0
        else:
            self.counter += 1
            if self.counter >= self.patience:
                self.early_stop = True

    def restore_best_weights(self, model):
        if self.best_model_weights is not None:
            model.load_state_dict(self.best_model_weights)

# ==============================================================================
# 🎛️ TRAINING & SEARCH CONFIGURATION
# ==============================================================================
MAX_EPOCHS = 50      # 50 is standard for production training
PATIENCE = 5
BATCH_SIZE = 32

OPTUNA_TRIALS = 10   # Standard number of search attempts
OPTUNA_EPOCHS = 5    # Enough trajectory for Bayesian prediction

# 🔥 DYNAMIC CLASS COUNT 
NUM_CLASSES = len(train_dataset.classes)
print(f"Dynamically detected {NUM_CLASSES} classes in the training dataset.")

targets = np.array(train_dataset.targets)
criterion = nn.CrossEntropyLoss()
models_to_benchmark = ["Baseline_CNN", "ResNet18", "MobileNetV2"]

# ==============================================================================
# 🗂️ THE MASTER DATA SPLIT (Single 80/20 Split replacing K-Fold)
# ==============================================================================
# We do this once globally so Optuna and the final training use the exact same holdout
train_idx, val_idx = train_test_split(
    np.arange(len(targets)), test_size=0.2, stratify=targets, random_state=42
)

master_train_loader = DataLoader(Subset(train_dataset, train_idx), batch_size=BATCH_SIZE, shuffle=True, num_workers=2, pin_memory=True)
master_val_loader = DataLoader(Subset(train_dataset, val_idx), batch_size=BATCH_SIZE, shuffle=False, num_workers=2, pin_memory=True)

# ==============================================================================
# 🔍 OPTUNA HYPERPARAMETER SEARCH (Runs conditionally based on STRATEGY)
# ==============================================================================
tuned_params = {}
params_path = f"{SAVE_DIR}/tuned_params.json"

if STRATEGY in ["tuned", "augmented_tuned"]:
    # 1. Load partial progress if the file exists
    if os.path.exists(params_path):
        with open(params_path, 'r') as f:
            tuned_params = json.load(f)
        print(f"\n📥 Loaded existing tuning progress for: {list(tuned_params.keys())}")
    else:
        print("\n" + "="*80)
        print("🔍 INITIATING STANDARD OPTUNA HYPERPARAMETER SEARCH")
        print("="*80)

    # Fast 80/20 split from the training dataset just for searching
    t_idx, v_idx = train_test_split(np.arange(len(targets)), test_size=0.2, stratify=targets, random_state=42)
    
    search_train_loader = DataLoader(Subset(train_dataset, t_idx), batch_size=BATCH_SIZE, shuffle=True, num_workers=2, pin_memory=True)
    search_val_loader = DataLoader(Subset(train_dataset, v_idx), batch_size=BATCH_SIZE, shuffle=False, num_workers=2, pin_memory=True)

    for m_name in models_to_benchmark:
        # 2. THE CHECK: Skip this specific model if it already finished and saved
        if m_name in tuned_params:
            print(f"\n>>> [SKIP] {m_name} already tuned: {tuned_params[m_name]}")
            continue
            
        print(f"\n>>> Tuning {m_name}...")
        
        def objective(trial):
            lr = trial.suggest_float("lr", 1e-4, 1e-2, log=True)
            wd = trial.suggest_float("weight_decay", 1e-5, 1e-2, log=True)
            
            model = build_model(m_name, num_classes=NUM_CLASSES, in_channels=IN_CHANNELS).to(device)
            optimizer = torch.optim.AdamW(model.parameters(), lr=lr, weight_decay=wd)
            
            for epoch in range(1, OPTUNA_EPOCHS + 1):
                model.train()
                pbar_opt = tqdm(search_train_loader, desc=f"Trial {trial.number} | Ep {epoch}/{OPTUNA_EPOCHS}", leave=False)
                
                for images, labels in pbar_opt:
                    images, labels = images.to(device), labels.to(device)
                    optimizer.zero_grad()
                    outputs = model(images)
                    loss = criterion(outputs, labels)
                    loss.backward()
                    optimizer.step()
                    pbar_opt.set_postfix({"loss": f"{loss.item():.4f}"})
                    
                val_loss, val_acc = evaluate_epoch(model, search_val_loader, criterion, device)
                
                trial.report(val_acc, epoch)
                if trial.should_prune():
                    raise optuna.exceptions.TrialPruned()
                    
            return val_acc
        
        optuna.logging.set_verbosity(optuna.logging.WARNING)
        study = optuna.create_study(direction="maximize", pruner=optuna.pruners.MedianPruner(n_warmup_steps=2))
        study.optimize(objective, n_trials=OPTUNA_TRIALS) 
        
        print(f" -> ✅ Best params for {m_name}: {study.best_params}")
        tuned_params[m_name] = study.best_params
        
        # 3. THE FIX: SAVE IMMEDIATELY AFTER EVERY MODEL (Notice the indentation)
        with open(params_path, 'w') as f:
            json.dump(tuned_params, f, indent=4)

else:
    # Safe Fallback for Baseline / Augmented variants
    for m_name in models_to_benchmark:
        tuned_params[m_name] = {"lr": 1e-3, "weight_decay": 1e-2}

# ==============================================================================
# 🏋️ THE FINAL TRAINING BENCHMARK (Single Split)
# ==============================================================================
for m_idx, model_name in enumerate(models_to_benchmark, 1):
    print("\n" + "="*80)
    print(f"🚀 ACTIVE BENCHMARK [{m_idx}/{len(models_to_benchmark)}]: {model_name}")
    print("="*80)
    
    # We leave "_fold1_" in the string purely so Snippet 8's regex scanner still works
    search_pattern = f"{SAVE_DIR}/{model_name}_fold1_val*_train*.pt"
    existing_files = glob.glob(search_pattern)
    
    if existing_files:
        print(f"\n>>> [SKIP] Found existing artifact for {model_name}: {existing_files[0]}")
        continue
        
    print(f"\n>>> Model: [{model_name}] | Running Final Training Phase...")
    
    model = build_model(model_name, num_classes=NUM_CLASSES, in_channels=IN_CHANNELS).to(device)
    
    # 🔥 APPLY TUNED PARAMETERS HERE
    lr = tuned_params[model_name]["lr"]
    wd = tuned_params[model_name]["weight_decay"]
    optimizer = torch.optim.AdamW(model.parameters(), lr=lr, weight_decay=wd)
    
    early_stopping = EarlyStopping(patience=PATIENCE)
    
    for epoch in range(1, MAX_EPOCHS + 1):
        model.train()
        running_loss, correct, total = 0.0, 0, 0
        
        pbar = tqdm(master_train_loader, desc=f"[{model_name}] | Ep {epoch:02d}/{MAX_EPOCHS}", leave=False)
        for images, labels in pbar:
            images, labels = images.to(device), labels.to(device)
            optimizer.zero_grad()
            outputs = model(images)
            loss = criterion(outputs, labels)
            loss.backward()
            optimizer.step()
            
            running_loss += loss.item() * images.size(0)
            _, preds = outputs.max(1)
            correct += preds.eq(labels).sum().item()
            total += labels.size(0)
            pbar.set_postfix({"loss": f"{running_loss / total:.4f}"})
            
        train_loss = running_loss / total
        train_acc = 100.0 * correct / total
        val_loss, val_acc = evaluate_epoch(model, master_val_loader, criterion, device)
        
        print(f"[{model_name}] Ep {epoch:02d} | Train Acc: {train_acc:.2f}% | Val Loss: {val_loss:.4f} (Acc: {val_acc:.2f}%)")
        
        early_stopping.step(val_loss, val_acc, train_acc, model)
        if early_stopping.early_stop:
            print(f" 🛑 Early stopping at epoch {epoch}.")
            break
            
    early_stopping.restore_best_weights(model)
    
    b_val = early_stopping.best_val_acc
    b_train = early_stopping.best_train_acc
    
    save_path = f"{SAVE_DIR}/{model_name}_fold1_val{b_val:.2f}_train{b_train:.2f}.pt"
    
    torch.save({
        'model_name': model_name,
        'model_state_dict': model.state_dict(),
        'val_acc': b_val,
        'classes': getattr(train_dataset, 'classes', None), 
        'input_size': (IN_CHANNELS, 224, 224),
    }, save_path)
    print(f" -> ✅ Saved Artifact: {save_path}")
