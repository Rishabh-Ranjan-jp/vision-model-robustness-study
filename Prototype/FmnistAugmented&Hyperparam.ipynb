# --- A. DYNAMIC TRANSFORM PIPELINE ---
if STRATEGY in ["augmented", "augmented_tuned"]:
    if IN_CHANNELS == 1:
        train_transform = transforms.Compose([
            transforms.Resize((224, 224)),
            transforms.RandomHorizontalFlip(p=0.5),
            transforms.ColorJitter(brightness=0.2, contrast=0.2), # 1-channel safe
            transforms.RandomRotation(15),
            transforms.ToTensor(),
            transforms.RandomErasing(p=0.3, scale=(0.02, 0.15), ratio=(0.3, 3.3), value=0),
            transforms.Normalize(DATASET_MEAN, DATASET_STD),
        ])
    else:
        train_transform = transforms.Compose([
            transforms.Resize((224, 224)),
            transforms.RandomHorizontalFlip(p=0.5),
            transforms.RandAugment(num_ops=2, magnitude=9),
            transforms.ColorJitter(brightness=0.2, contrast=0.2, saturation=0.2, hue=0.1),
            transforms.ToTensor(),
            transforms.RandomErasing(p=0.3, scale=(0.02, 0.15), ratio=(0.3, 3.3), value=0),
            transforms.Normalize(DATASET_MEAN, DATASET_STD),
        ])
    print("🧬 Loaded AUGMENTED Transform Pipeline")
else:
    train_transform = transforms.Compose([
        transforms.Resize((224, 224)),
        transforms.ToTensor(),
        transforms.Normalize(DATASET_MEAN, DATASET_STD),
    ])
    print("🧼 Loaded CLEAN Baseline Transform Pipeline")

test_transform = transforms.Compose([
    transforms.Resize((224, 224)),
    transforms.ToTensor(),
    transforms.Normalize(DATASET_MEAN, DATASET_STD),
])

# --- B. CUSTOM ISIC LOADER ---
class ISIC2019Dataset(Dataset):
    def __init__(self, csv_file, img_dir, transform=None):
        self.img_dir, self.transform = img_dir, transform
        self.df = pd.read_csv(csv_file)
        self.classes = ['MEL', 'NV', 'BCC', 'AK', 'BKL', 'DF', 'VASC', 'SCC', 'UNK']
        class_names = self.df[self.classes].idxmax(axis=1)
        self.targets = [self.classes.index(cls) for cls in class_names]
        
    def __len__(self): return len(self.df)
    
    def __getitem__(self, idx):
        img_path = os.path.join(self.img_dir, self.df.iloc[idx]['image'] + '.jpg')
        image = Image.open(img_path).convert("RGB")
        if self.transform: image = self.transform(image)
        return image, self.targets[idx]

# --- C. DATASET ROUTER ---
if DATASET_NAME == "cifar10":
    train_dataset = torchvision.datasets.CIFAR10(root=DATA_DIR, train=True, download=True, transform=train_transform)
    test_dataset  = torchvision.datasets.CIFAR10(root=DATA_DIR, train=False, download=True, transform=test_transform)

elif DATASET_NAME == "fashionmnist":
    train_dataset = torchvision.datasets.FashionMNIST(root=DATA_DIR, train=True, download=True, transform=train_transform)
    test_dataset  = torchvision.datasets.FashionMNIST(root=DATA_DIR, train=False, download=True, transform=test_transform)

elif DATASET_NAME in ["eurosat", "isic"]:
    if DATASET_NAME == "eurosat":
        full_train = torchvision.datasets.EuroSAT(root=DATA_DIR, download=True, transform=train_transform)
        full_test  = torchvision.datasets.EuroSAT(root=DATA_DIR, download=True, transform=test_transform)
    else:
        csv_path, img_dir = "./ISIC_2019_Training_GroundTruth.csv", "./ISIC_2019_Training_Input"
        if not os.path.exists(csv_path): raise FileNotFoundError(f"⚠️ ISIC CSV missing: {csv_path}")
        full_train = ISIC2019Dataset(csv_file=csv_path, img_dir=img_dir, transform=train_transform)
        full_test  = ISIC2019Dataset(csv_file=csv_path, img_dir=img_dir, transform=test_transform)
    
    indices = np.random.RandomState(42).permutation(len(full_train))
    t_idx, v_idx = indices[:int(0.8 * len(full_train))], indices[int(0.8 * len(full_train)):]
    
    train_dataset, test_dataset = Subset(full_train, t_idx), Subset(full_test, v_idx)
    
    train_dataset.targets, train_dataset.classes = [full_train.targets[i] for i in t_idx], full_train.classes
    test_dataset.targets, test_dataset.classes = [full_test.targets[i] for i in v_idx], full_test.classes

else:
    raise ValueError(f"Unknown DATASET_NAME: {DATASET_NAME}")

# --- D. DATALOADER INITIALIZATION ---
