import sys

def silence_dataloader_destructor_spam():
    original_hook = sys.unraisablehook
    def custom_hook(unraisable):
        # If it's the specific DataLoader worker panic, just ignore it silently
        if "can only test a child process" in str(unraisable.exc_value):
            pass
        else:
            # Otherwise, print the error normally
            original_hook(unraisable)
    sys.unraisablehook = custom_hook

silence_dataloader_destructor_spam()
