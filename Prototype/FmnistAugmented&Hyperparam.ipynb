# 1. Select a clean sample from raw test dataset
sample_idx = 12  
raw_sample_img, true_label = raw_test_dataset[sample_idx]

# Classes are dynamically inherited from Snippet 8
all_perturbations = [
    "gaussian_blur", "gaussian_noise", "brightness", "rotation", 
    "contrast", "sensor_interference", "environmental_obstruction", "capture_instability"
]

eval_intensity = 0.40  # Meaningful stress-test intensity

print("\n" + "="*90)
print(f"🖼️ RENDERING COMPARATIVE PERTURBATION SAMPLES (True Class: {classes[true_label].upper()})")
print("="*90)

for m_name, model in trained_models.items():
    print(f"\n>>> Generating Matrix for Architecture: [{m_name}]")
    model.eval()
    
    fig, axes = plt.subplots(len(all_perturbations), 3, figsize=(10, 2.8 * len(all_perturbations)))
    
    with torch.no_grad():
        clean_tensor = pert_engine.normalize(raw_sample_img.unsqueeze(0)).to(device)
        clean_probs = F.softmax(model(clean_tensor), dim=1).cpu().numpy()[0]
        clean_pred = np.argmax(clean_probs)
        clean_conf = clean_probs[clean_pred] * 100.0

    for idx, p_type in enumerate(all_perturbations):
        with torch.no_grad():
            raw_pert = pert_engine.apply_raw_perturbation(raw_sample_img.unsqueeze(0), p_type, eval_intensity).squeeze(0)
            norm_pert = pert_engine.normalize(raw_pert.unsqueeze(0)).to(device)
            pert_probs = F.softmax(model(norm_pert), dim=1).cpu().numpy()[0]
            pert_pred = np.argmax(pert_probs)
            pert_conf = pert_probs[pert_pred] * 100.0
            
        clean_display = raw_sample_img.permute(1, 2, 0).numpy()
        pert_display = raw_pert.permute(1, 2, 0).numpy()

        axes[idx, 0].imshow(clean_display)
        axes[idx, 0].set_title(f"Clean Input\nPred: {classes[clean_pred]} ({clean_conf:.1f}%)", fontsize=9)
        axes[idx, 0].axis('off')

        axes[idx, 1].imshow(pert_display)
        is_correct = (pert_pred == true_label)
        status_color = "green" if is_correct else "red"
        axes[idx, 1].set_title(f"[{p_type.replace('_', ' ').title()}]\nPred: {classes[pert_pred]} ({pert_conf:.1f}%)", 
                               fontsize=9, color=status_color, fontweight='bold')
        axes[idx, 1].axis('off')

        top3_indices = np.argsort(pert_probs)[-3:][::-1]
        top3_labels = [classes[i] for i in top3_indices]
        top3_vals = [pert_probs[i] * 100.0 for i in top3_indices]
        
        axes[idx, 2].barh(top3_labels, top3_vals, color='skyblue')
        axes[idx, 2].set_xlim(0, 100)
        axes[idx, 2].set_xlabel("Confidence (%)", fontsize=8)
        axes[idx, 2].invert_yaxis()
        axes[idx, 2].tick_params(axis='both', which='major', labelsize=8)

    plt.suptitle(f"Model Diagnostic Matrix: {m_name} (Intensity I = {eval_intensity})", fontsize=13, fontweight='bold', y=1.002)
    plt.tight_layout()
    plt.show()
